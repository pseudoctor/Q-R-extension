{
  "name": "toulmin-reader-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "check:extension": "node scripts/check-extension.mjs",
    "check:store-assets": "node scripts/check-store-assets.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:extension": "pnpm build && pnpm check:extension && pnpm check:release && node scripts/package-extension.mjs",
    "check:article-format": "node --experimental-strip-types scripts/check-article-format.mjs",
    "check:pre-reading": "node --experimental-strip-types scripts/check-pre-reading-prediction.mjs",
    "check:training-flow": "node --experimental-strip-types scripts/check-reading-training-flow.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:storage-concurrency": "node scripts/check-storage-concurrency.mjs",
    "check:training-audit": "node scripts/check-training-audit.mjs",
    "check:ai-storage": "node --experimental-strip-types scripts/check-ai-storage.mjs",
    "check:message-security": "node --experimental-strip-types scripts/check-message-security.mjs",
    "check:ai-http": "node --experimental-strip-types scripts/check-ai-http.mjs",
    "check:provider-settings": "node --experimental-strip-types scripts/check-provider-settings.mjs",
    "check:browser": "node scripts/check-browser-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
