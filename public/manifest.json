{
  "manifest_version": 3,
  "name": "问读 · 浏览器伴读",
  "version": "0.1.0",
  "description": "从网页保存文章，并继续进行图尔敏阅读训练。",
  "action": {
    "default_title": "打开问读伴读"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*"
  ],
  "commands": {
    "capture-and-open": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "获取当前文章并打开问读训练页"
    }
  }
}
